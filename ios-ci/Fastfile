APP_IDENTIFIER = "com.jdarkyeka6.TideCam"
APP_NAME = "TideCam"

default_platform(:ios)

platform :ios do
  desc "Build TideCam and upload it to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    missing = []
    missing << "ASC_KEY_ID" if key_id.empty?
    missing << "ASC_ISSUER_ID" if issuer_id.empty?
    missing << "APPLE_TEAM_ID" if team_id.empty?
    missing << "ASC_KEY_CONTENT" if ENV["ASC_KEY_CONTENT"].to_s.strip.empty?
    UI.user_error!("Missing Apple CI secret(s): #{missing.join(', ')}") unless missing.empty?

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text = if raw.include?("BEGIN PRIVATE KEY")
      raw
    else
      require "base64"
      Base64.decode64(raw)
    end

    UI.user_error!("ASC_KEY_CONTENT is not a valid .p8 private key") unless key_text.include?("BEGIN PRIVATE KEY")

    key_path = File.expand_path("~/tidecam_asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    require "spaceship"

    unless Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
      UI.message("Registering #{APP_IDENTIFIER} in Apple Developer...")
      Spaceship::ConnectAPI::BundleId.create(
        name: APP_NAME,
        identifier: APP_IDENTIFIER,
        platform: "IOS"
      )
    end

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    unless app
      UI.user_error!(
        "APP_STORE_RECORD_MISSING: Create an iOS app named '#{APP_NAME}' in App Store Connect using bundle ID '#{APP_IDENTIFIER}', then re-run this workflow."
      )
    end

    keychain_name = "tidecam-ci.keychain"
    keychain_pw = "tidecam-ci-temp"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    if ENV["USE_SHARED_SIGNING"] == "1"
      # This path only retrieves an existing signing identity. It never creates
      # or revokes a distribution certificate or changes Apple profiles.
      required = %w[MATCH_GIT_URL MATCH_GIT_BASIC_AUTHORIZATION MATCH_PASSWORD]
      missing = required.select { |name| ENV[name].to_s.empty? }
      UI.user_error!("Shared signing needs GitHub secrets: #{missing.join(', ')}") unless missing.empty?

      match(
        type: "appstore",
        readonly: true,
        git_url: ENV.fetch("MATCH_GIT_URL"),
        git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
        app_identifier: [APP_IDENTIFIER],
        api_key: api_key,
        keychain_name: keychain_name,
        keychain_password: keychain_pw
      )
      mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
      profile_name = mapping[APP_IDENTIFIER]
      UI.user_error!("Shared signing profile is missing for TideCam") unless profile_name
    else
      # Legacy mode is retained temporarily, without certificate revocation.
      # New apps should use the beta_shared lane after Match is provisioned.
      cert(**{
        api_key: api_key,
        generate_apple_certs: true,
        keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
        keychain_password: keychain_pw
      })
      sigh(api_key: api_key, app_identifier: APP_IDENTIFIER, force: true)
      profile_name = lane_context[SharedValues::SIGH_NAME]
    end

    update_code_signing_settings(
      path: "TideCam.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["TideCam"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )

    increment_build_number(
      xcodeproj: "TideCam.xcodeproj",
      build_number: latest + 1
    )

    build_app(
      project: "TideCam.xcodeproj",
      scheme: "TideCam",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false
    )
  end
  desc "Use an existing shared Apple Distribution identity with Fastlane Match"
  lane :beta_shared do
    ENV["USE_SHARED_SIGNING"] = "1"
    beta
  end

end
