APP_IDENTIFIER = "com.jdarkyeka6.TideCam"
APP_NAME = "TideCam"

default_platform(:ios)

platform :ios do
  desc "Build TideCam and upload it to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    missing = []
    missing << "ASC_KEY_ID" if key_id.empty?
    missing << "ASC_ISSUER_ID" if issuer_id.empty?
    missing << "APPLE_TEAM_ID" if team_id.empty?
    missing << "ASC_KEY_CONTENT" if ENV["ASC_KEY_CONTENT"].to_s.strip.empty?
    UI.user_error!("Missing Apple CI secret(s): #{missing.join(', ')}") unless missing.empty?

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text = if raw.include?("BEGIN PRIVATE KEY")
      raw
    else
      require "base64"
      Base64.decode64(raw)
    end

    UI.user_error!("ASC_KEY_CONTENT is not a valid .p8 private key") unless key_text.include?("BEGIN PRIVATE KEY")

    key_path = File.expand_path("~/tidecam_asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    require "spaceship"

    unless Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
      UI.message("Registering #{APP_IDENTIFIER} in Apple Developer...")
      Spaceship::ConnectAPI::BundleId.create(
        name: APP_NAME,
        identifier: APP_IDENTIFIER,
        platform: "IOS"
      )
    end

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    unless app
      UI.user_error!(
        "APP_STORE_RECORD_MISSING: Create an iOS app named '#{APP_NAME}' in App Store Connect using bundle ID '#{APP_IDENTIFIER}', then re-run this workflow."
      )
    end

    keychain_name = "tidecam-ci.keychain"
    keychain_pw = "tidecam-ci-temp"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    cert_args = {
      api_key: api_key,
      generate_apple_certs: true,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    }

    # Prefer a pre-existing signing identity from encrypted Actions secrets,
    # instead of creating/revoking distribution certificates on each CI run.
    existing_p12 = ENV["IOS_DISTRIBUTION_P12_BASE64"].to_s.strip
    if !existing_p12.empty?
      p12_password = ENV["IOS_DISTRIBUTION_P12_PASSWORD"].to_s
      UI.user_error!("IOS_DISTRIBUTION_P12_PASSWORD missing") if p12_password.empty?
      require "base64"
      p12_path = File.expand_path("~/tidecam_distribution.p12")
      File.binwrite(p12_path, Base64.strict_decode64(existing_p12))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: p12_password,
        keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
        keychain_password: keychain_pw,
        log_output: false
      )
      File.delete(p12_path)
      UI.success("Imported existing distribution identity; no new signing certificate required.")
    end

    # Never automatically revoke an existing distribution certificate.
    # Without an importable identity, Fastlane must stop at Apple's limit.
    cert(**cert_args)

    profile_attempt = 0
    begin
      profile_attempt += 1
      sigh(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        force: true
      )
    rescue => e
      message = e.message.to_s.downcase
      transient_apple_error =
        message.include?("server error got 500") ||
        message.include?("internal server error") ||
        message.include?("status code: 500")

      if transient_apple_error && profile_attempt < 5
        delay = profile_attempt * 10
        UI.important("Apple's provisioning-profile service returned a temporary 500. Retrying in #{delay}s (attempt #{profile_attempt + 1}/5).")
        sleep delay
        retry
      end

      raise
    end

    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "TideCam.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["TideCam"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )

    increment_build_number(
      xcodeproj: "TideCam.xcodeproj",
      build_number: latest + 1
    )

    build_app(
      project: "TideCam.xcodeproj",
      scheme: "TideCam",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false
    )
  end
  desc "Read-only Apple Distribution certificate inventory for choosing replacement"
  lane :certificate_inventory do
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    UI.user_error!("Apple credentials missing") if [key_id, issuer_id, raw].any?(&:empty?)
    require "base64"
    key_text = raw.include?("BEGIN PRIVATE KEY") ? raw : Base64.decode64(raw)
    UI.user_error!("Invalid API key text") unless key_text.include?("BEGIN PRIVATE KEY")
    key_path = File.expand_path("~/tidecam_inventory_api_key.p8")
    File.write(key_path, key_text)
    api_key = app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path)
    require "spaceship"
    require "time"

    accepted_types = [
      Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
      Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION
    ]
    certificates = Spaceship::ConnectAPI::Certificate.all
      .select { |cert| accepted_types.include?(cert.certificate_type) }
      .sort_by { |cert| Time.parse(cert.expiration_date.to_s) rescue Time.at(0) }
    UI.message("DISTRIBUTION CERTIFICATE INVENTORY (read only; no changes)")
    certificates.each_with_index do |cert, index|
      UI.message("RANK=#{index + 1} CERT_ID=#{cert.id} TYPE=#{cert.certificate_type} NAME=#{cert.name} EXPIRES=#{cert.expiration_date}")
    end
    UI.message("DISTRIBUTION_CERTIFICATE_COUNT=#{certificates.length}")
  end

  desc "Revoke only the explicitly selected oldest Apple Distribution certificate"
  lane :revoke_old_distribution do
    expected_id = "DPJ24D5FLB"
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    UI.user_error!("Apple API credentials missing") if [key_id, issuer_id, raw].any?(&:empty?)
    require "base64"
    require "time"
    key_text = raw.include?("BEGIN PRIVATE KEY") ? raw : Base64.decode64(raw)
    UI.user_error!("Malformed key") unless key_text.include?("BEGIN PRIVATE KEY")
    key_path = File.expand_path("~/tidecam_revoke_api_key.p8")
    File.write(key_path, key_text)
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path)
    require "spaceship"

    allowed_types = [
      Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
      Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION
    ]
    candidates = Spaceship::ConnectAPI::Certificate.all
      .select { |cert| allowed_types.include?(cert.certificate_type) }
      .sort_by { |cert| Time.parse(cert.expiration_date.to_s) }
    UI.user_error!("No Apple Distribution certificates found") if candidates.empty?
    target = candidates.first
    UI.user_error!("Certificate inventory changed. Expected #{expected_id}, got #{target.id}; refusing to revoke.") unless target.id == expected_id
    UI.user_error!("Cannot revoke the only remaining distribution certificate") unless candidates.length >= 2
    expected_expiration = Time.parse("2027-10-08T07:02:11Z")
    UI.user_error!("Certificate expiry changed; refusing to revoke") unless Time.parse(target.expiration_date.to_s).to_i == expected_expiration.to_i

    UI.important("Revoking specifically approved oldest Apple Distribution certificate #{target.id}. Other certificates remain unchanged.")
    target.delete!
    remaining = Spaceship::ConnectAPI::Certificate.all
      .select { |cert| allowed_types.include?(cert.certificate_type) }
    UI.user_error!("Revocation not verified: certificate still exists") if remaining.any? { |cert| cert.id == expected_id }
    UI.success("Verified revoked Apple Distribution certificate #{expected_id}; remaining count=#{remaining.length}.")
  end

end
